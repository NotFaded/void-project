# ─── VOID PROJECT — ENV VARS ───────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.

# The Solana wallet address that receives all deposits
NEXT_PUBLIC_DEPOSIT_WALLET=YOUR_SOLANA_WALLET_ADDRESS_HERE

# Deposit amount in SOL (what users will send)
NEXT_PUBLIC_DEPOSIT_AMOUNT_SOL=0.1

# Reveal date — ISO 8601 format (UTC)
# Example: 30 days from now
NEXT_PUBLIC_REVEAL_DATE=2026-07-01T00:00:00Z

# Solana RPC endpoint (use mainnet-beta for production, devnet for testing)
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
# For devnet testing:
# NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# Your site's base URL (used for referral links)
NEXT_PUBLIC_SITE_URL=https://void.xyz

# Optional: custom RPC with higher rate limits (e.g. Helius, Quicknode, Alchemy)
# NEXT_PUBLIC_SOLANA_RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
